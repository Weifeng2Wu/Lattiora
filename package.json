{
	"name": "lattiora",
	"private": true,
	"version": "0.36.1",
	"type": "module",
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "vite",
		"build": "tsc && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
		"clean": "node scripts/clean-build-artifacts.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:ts": "biome check .",
		"format": "biome format --write .",
		"format:ts": "biome format --write .",
		"fix": "biome check --write .",
		"fix:ts": "biome check --write .",
		"prepare": "husky",
		"deps:check": "depcruise --config .dependency-cruiser.cjs src",
		"typecheck:worker": "tsc -p cloudflare/tsconfig.json",
		"dev:web": "wrangler dev --port 8790 --inspector-port 9232",
		"db:migrate:local": "wrangler d1 migrations apply agentero-web --local",
		"db:migrate:remote": "node scripts/cloudflare.mjs d1 migrations apply agentero-web --remote",
		"deploy": "pnpm build && node scripts/cloudflare.mjs deploy",
		"test:cloud": "vitest run test/cloud-*.test.ts",
		"test:browser": "playwright test"
	},
